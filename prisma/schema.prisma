// Operations Platform — schema
//
// The data model of the Operations Platform prototype, made durable.
//
// Four rules hold across every table here:
//   1. TENANCY. Every table except `tenants` carries tenantId, has a foreign key
//      to tenants, and is covered by a row-level security policy (see the init
//      migration). The app connects as a role without BYPASSRLS, so a query
//      that forgets to filter by tenant returns nothing rather than another
//      workspace's data. tests/schema.test.ts fails if a table misses any of it.
//   2. MONEY. BigInt minor units (paise for INR, cents for USD/USDT/USDC).
//      Never a float. A foreign-currency receipt stores both what arrived and
//      the rupees it became, so a later rate never rewrites history.
//   3. HISTORY. audit_log is append-only for the application role.
//   4. ACCESS. Two separate grants, as in the prototype:
//        members.features  which sections a person can use (none/view/edit)
//        client_grants     which clients, and how far (view/edit/finance)
//      An owner holds everything and cannot be narrowed.

generator client {
  provider        = "prisma-client-js"
  // One SQL statement per query instead of one per level of include; each
  // extra statement costs a round trip to the database.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  /// IANA zone. "Today", due dates and month boundaries are read here.
  timezone          String   @default("Asia/Kolkata")
  /// Paise per hour of logged task time, used for client cost and margin.
  hourlyRate        BigInt   @default(180000)
  /// Active | Suspended
  status            String   @default("Active")
  incomeCategories  String[] @default([])
  expenseCategories String[] @default([])
  /// Departments people belong to (HR). Task departments are their own table.
  hrDepartments     String[] @default([])
  /// Income categories that earn no commission - e.g. wallet top-ups, which are
  /// mostly money passed on to Meta rather than money the business keeps.
  /// Empty means every rupee received counts.
  commissionSkip    String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members         Member[]
  sessions        Session[]
  loginLinks      LoginLink[]
  salaryChanges   SalaryChange[]
  brands          Brand[]
  clients         Client[]
  clientRates     ClientRate[]
  clientGrants    ClientGrant[]
  ledger          LedgerEntry[]
  taskDepartments TaskDepartment[]
  tasks           Task[]
  taskChanges     TaskStatusChange[]
  taskNotes       TaskNote[]
  taskSeries      TaskSeries[]
  sheetColumns    SheetColumn[]
  leaves          Leave[]
  holidays        Holiday[]
  audit           AuditEntry[]
  commissionRates CommissionRate[]
  commissionRules CommissionRule[]
  adSpends        AdSpend[]
  targets         Target[]

  @@map("tenants")
}

/// A person on the team. Somebody without a password is on the team but cannot
/// sign in yet; a login link lets them set one.
model Member {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  /// Lowercased. Optional: payroll-only staff need not sign in.
  email        String?
  passwordHash String?
  /// Job title, e.g. "Content writer".
  title        String  @default("Team member")
  /// Owners hold every section and every client, take partner draws, and are
  /// the only ones who can change client grants.
  isOwner      Boolean @default(false)
  /// Section -> "none" | "view" | "edit". Missing keys mean "none".
  features     Json    @default("{}")
  /// Task departments this person is limited to. Empty means all of them.
  taskDeptIds  String[] @default([])
  /// Set when this person is mirrored from another system - the id they have
  /// there (a WabMeta AdminUser). A repeated sync updates this row instead of
  /// adding a second copy of the same person. Null for people created here.
  externalId   String?

  // ── HR
  department     String?
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// Full-time | Part-time | Contract | Intern | Founder
  employmentType String    @default("Full-time")
  startDate      DateTime? @db.Date
  /// Active | Probation | On leave | Notice period | Exited
  hrStatus       String    @default("Active")
  /// Monthly salary in paise. Null means not on payroll.
  salary         BigInt?
  leaveTotal     Int       @default(18)
  leaveUsed      Int       @default(0)
  phone          String?
  managerId      String?
  manager        Member?   @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports        Member[]  @relation("ReportsTo")

  // ── how salary is paid
  /// bank | upi
  payMethod  String?
  payUpi     String?
  payHolder  String?
  payBank    String?
  payAccount String?
  payIfsc    String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions        Session[]
  loginLinks      LoginLink[]       @relation("LinkFor")
  loginLinksMade  LoginLink[]       @relation("LinkBy")
  salaryChanges   SalaryChange[]
  grants          ClientGrant[]
  ledgerCreated   LedgerEntry[]     @relation("LedgerBy")
  salaryEntries   LedgerEntry[]     @relation("LedgerFor")
  draws           LedgerEntry[]     @relation("LedgerPartner")
  tasksAssigned   Task[]            @relation("TaskAssignee")
  tasksGiven      Task[]            @relation("TaskAssigner")
  statusChanges   TaskStatusChange[]
  notes           TaskNote[]
  seriesAssigned  TaskSeries[]      @relation("SeriesAssignee")
  seriesCreated   TaskSeries[]      @relation("SeriesCreator")
  leaves          Leave[]           @relation("LeaveFor")
  leavesDecided   Leave[]           @relation("LeaveDecider")
  auditEntries    AuditEntry[]
  clientsOwned    Client[]          @relation("ClientOwner")
  clientsOnboarding Client[]        @relation("ClientOnboarder")
  commissionRates CommissionRate[]
  commissionRules CommissionRule[]
  adSpends        AdSpend[]
  targets         Target[]

  @@unique([tenantId, email])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@map("members")
}

model Session {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([memberId])
  @@map("sessions")
}

/// A one-time link that lets a team member set their password: the way in for
/// somebody added to the team, and the way back for somebody who forgot it.
model LoginLink {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation("LinkFor", fields: [memberId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. The token itself is shown once and never stored.
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdBy   Member    @relation("LinkBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@map("login_links")
}

model SalaryChange {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @db.Date
  /// Paise per month.
  amount        BigInt
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([memberId])
  @@map("salary_changes")
}

/// What share of the money a member's own clients pay is theirs, and from
/// when. Kept as history like salary: a new rate applies from its date, and
/// money received before it is still worked out at the rate then in force.
model CommissionRate {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @db.Date
  /// Basis points: 1000 is 10%. An integer, so a rate cannot drift.
  bps           Int
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([memberId])
  @@map("commission_rates")
}

/// A commission given by hand - to anybody, for anything: a fixed amount per
/// onboarding, a bonus, a share of one client's money for somebody who did not
/// bring it in. On top of the automatic commission, never instead of it.
model CommissionRule {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// The client it is about, if any. Required for a percentage: a share of
  /// what this client paid that month.
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// fixed | percent
  kind        String
  /// fixed: paise.
  amount      BigInt    @default(0)
  /// percent: basis points of what the client paid in the month.
  bps         Int       @default(0)
  /// once | monthly
  repeat      String    @default("once")
  /// The first month it counts in (the 1st of that month).
  fromMonth   DateTime  @db.Date
  /// The last month a monthly rule counts in. Null runs until it is stopped.
  toMonth     DateTime? @db.Date
  note        String    @default("")
  createdById String
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([memberId])
  @@map("commission_rules")
}

/// Ads run for one person in one month, and the leads they brought.
///
/// The money is also an expense in ledger_entries (category "Ads"), written in
/// the same transaction and removed with it - the ledger stays the one place
/// money lives, so the month's profit already counts ad spend. This row adds
/// what the ledger cannot hold: whose leads they were, and how many.
model AdSpend {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// The 1st of the month the ads started in.
  month         DateTime @db.Date
  /// "day" | "week" | "month": what the entry was recorded for.
  period        String   @default("month")
  /// The days the spend covers, both ends included. A week runs Monday to
  /// Sunday and may cross into the next month.
  fromDate      DateTime @db.Date
  toDate        DateTime @db.Date
  /// Paise. Zero is allowed: leads that cost nothing still count as leads.
  amount        BigInt   @default(0)
  leads         Int      @default(0)
  note          String   @default("")
  /// The expense this spend wrote, if it cost anything.
  ledgerEntryId String?
  createdById   String
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([memberId])
  @@map("ad_spends")
}

/// A sales target for a month: for the whole team (memberId null) or for one
/// person. Only the targets are stored - what was achieved is counted from the
/// clients and money WabMeta syncs, so it cannot drift from them.
/// One per person (or team) per month, enforced by a unique index in the
/// migration that treats a null memberId as a value (NULLS NOT DISTINCT).
model Target {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String?
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// The 1st of the month.
  month       DateTime @db.Date
  /// New clients to bring in this month.
  sales       Int?
  /// Paise to receive this month.
  amount      BigInt?
  /// Per day, for the week and today views.
  dailySales  Int?
  dailyAmount BigInt?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([memberId])
  @@map("targets")
}

/// A company the workspace runs. An agency brand works for clients; a startup
/// brand has its own work areas (Social Media, Tech, …) instead.
model Brand {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// agency | startup
  kind      String   @default("agency")
  areas     String[] @default([])
  createdAt DateTime @default(now())

  members Member[]
  clients Client[]
  tasks   Task[]
  series  TaskSeries[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

model Client {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id])
  name      String
  company   String    @default("")
  /// Monthly retainer in paise.
  retainer  BigInt    @default(0)
  /// The currency they pay in: INR | USD | USDT | USDC
  currency  String    @default("INR")
  services  String    @default("")
  contact   String    @default("")
  sinceDate DateTime? @db.Date
  /// Day of the month they pay, 1–31.
  payDay    Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Removed clients leave every list; their money and history stay.
  removedAt DateTime?

  /// The system this client is mirrored from, e.g. "wabmeta". Null means it
  /// was created here and nothing outside owns it.
  externalSource String?
  /// The id it has in that system. Unique per tenant, so a redelivered sync
  /// event updates this client rather than creating a second one.
  externalId     String?
  /// The team member who brought the client in - the onboarder, on the
  /// WabMeta side. This is credit, not access: who may open the client is
  /// client_grants, and the two are deliberately separate.
  ownerMemberId  String?
  owner          Member? @relation("ClientOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  /// The team member onboarding the client - set up, plan, getting it live.
  /// Often a different person from the owner: in WabMeta a sales person sells
  /// the client and then hands it to an onboarder. The sale stays the owner's.
  onboarderMemberId String?
  onboarder         Member? @relation("ClientOnboarder", fields: [onboarderMemberId], references: [id], onDelete: SetNull)

  // ── the client's account
  /// The login the client signs in with - their email in WabMeta. Mirrored
  /// from WabMeta for synced clients; typed in here for the rest.
  loginId       String    @default("")
  phone         String    @default("")
  /// The plan they are on in WabMeta. Mirrored only.
  plan          String    @default("")
  /// Free notes about the client. Owned by TeamOS: the sync never writes it.
  details       String    @default("")
  /// The client's password, if an owner chose to keep it here - encrypted with
  /// CLIENT_VAULT_KEY (src/lib/vault.ts), never sent to the browser with the
  /// workspace, and decrypted only on an owner's request, which is audited.
  passwordEnc   String?
  passwordSetAt DateTime?
  /// The onboarder's setup sheet, mirrored from WabMeta: business type, when
  /// setup finished, and one line per thing set up. Never holds a password -
  /// only whether a line has one in WabMeta.
  setup         Json?

  rates  ClientRate[]
  grants ClientGrant[]
  commissionRules CommissionRule[]
  ledger LedgerEntry[]
  tasks  Task[]
  series TaskSeries[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([ownerMemberId])
  @@index([onboarderMemberId])
  @@map("clients")
}

/// What a client pays per month, and since when. The current rate has no end.
model ClientRate {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromDate  DateTime  @db.Date
  toDate    DateTime? @db.Date
  /// Minor units of `currency`.
  amount    BigInt
  currency  String
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([clientId])
  @@map("client_rates")
}

/// How far one member reaches into one client. No row means no access.
model ClientGrant {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// view | edit | finance
  level    String

  @@id([memberId, clientId])
  @@index([tenantId])
  @@map("client_grants")
}

/// Income and expenses. One table, one set of totals.
model LedgerEntry {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// in | out
  type        String
  date        DateTime  @db.Date
  description String
  /// Null means overhead: money that belongs to no client.
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  category    String
  /// Rupees, in paise. For foreign income: what it became after conversion.
  amount      BigInt
  /// paid | pending
  status      String    @default("paid")
  /// When a pending entry from an earlier month was finally settled.
  paidOn      DateTime? @db.Date
  /// For income received in another currency.
  currency    String?
  /// Minor units of `currency`, as received.
  origAmount  BigInt?
  /// How it was paid, e.g. "MetaMask", "Bank".
  method      String?
  /// Salary entries: whose salary.
  memberId    String?
  member      Member?   @relation("LedgerFor", fields: [memberId], references: [id], onDelete: SetNull)
  /// Partner draws: which owner drew.
  partnerId   String?
  partner     Member?   @relation("LedgerPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  /// Partner draws: the client payment the draw came out of.
  sourceId    String?
  note        String?
  /// Set when the entry is mirrored from another system, e.g.
  /// "payment:<razorpay payment id>". Unique per tenant, and that is the
  /// whole point: a sync event delivered twice updates this row instead of
  /// recording the same money a second time.
  externalId  String?
  createdById String
  createdBy   Member    @relation("LedgerBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, externalId])
  @@index([tenantId, date])
  @@index([clientId])
  @@map("ledger_entries")
}

model TaskDepartment {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// Dot colour on the board.
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  tasks  Task[]
  series TaskSeries[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("task_departments")
}

model Task {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  brandId      String
  brand        Brand          @relation(fields: [brandId], references: [id])
  /// The client the work is for. Null for a brand's own work.
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id])
  /// A startup brand's work area, when there is no client.
  area         String         @default("")
  assigneeId   String
  assignee     Member         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignedById String
  assignedBy   Member         @relation("TaskAssigner", fields: [assignedById], references: [id])
  /// todo | doing | review | blocked | done
  status       String         @default("todo")
  departmentId String
  department   TaskDepartment @relation(fields: [departmentId], references: [id])
  /// Hours logged, which cost the client at the workspace hourly rate.
  hours        Decimal        @default(0) @db.Decimal(8, 2)
  due          DateTime?      @db.Date
  dueTime      String?
  /// high | medium | low
  priority     String         @default("medium")
  /// Estimate in hours.
  estimate     Decimal?       @db.Decimal(8, 2)
  createdOn    DateTime       @db.Date
  verified     Boolean        @default(false)
  /// Set when this task is one occurrence of a recurring series.
  seriesId     String?
  series       TaskSeries?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// Values for the sheet's custom columns, keyed by column id.
  custom       Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  changes TaskStatusChange[]
  notes   TaskNote[]

  /// One occurrence per series per day, so rolling a series is idempotent.
  @@unique([seriesId, due])
  @@index([tenantId])
  @@index([assigneeId])
  @@index([clientId])
  @@map("tasks")
}

model TaskStatusChange {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status   String
  at       DateTime @default(now())
  byId     String
  by       Member   @relation(fields: [byId], references: [id])

  @@index([tenantId])
  @@index([taskId])
  @@map("task_status_changes")
}

model TaskNote {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  byId     String
  by       Member   @relation(fields: [byId], references: [id])
  at       DateTime @default(now())
  text     String
  /// The first link in the text, pulled out so it can be shown as a doc link.
  link     String?

  @@index([tenantId])
  @@index([taskId])
  @@map("task_notes")
}

/// A task that repeats. Each occurrence is created as its own task on the day
/// it falls due, so a missed day stays visible as a late task.
model TaskSeries {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  brandId      String
  brand        Brand           @relation(fields: [brandId], references: [id])
  clientId     String?
  client       Client?         @relation(fields: [clientId], references: [id])
  area         String          @default("")
  assigneeId   String
  assignee     Member          @relation("SeriesAssignee", fields: [assigneeId], references: [id])
  createdById  String
  createdBy    Member          @relation("SeriesCreator", fields: [createdById], references: [id])
  departmentId String?
  department   TaskDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  priority     String          @default("medium")
  estimate     Decimal?        @db.Decimal(8, 2)
  active       Boolean         @default(true)
  /// daily | weekdays | weekly | every
  freq         String
  /// 0 = Sunday … 6 = Saturday, for weekly.
  weekday      Int?
  /// For "every N days".
  everyDays    Int             @default(1)
  /// HH:MM, optional.
  time         String?
  startDate    DateTime        @db.Date
  untilDate    DateTime?       @db.Date
  createdAt    DateTime        @default(now())

  tasks Task[]

  @@index([tenantId])
  @@map("task_series")
}

/// A custom column in the Tasks sheet view, shared by the workspace.
model SheetColumn {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("sheet_columns")
}

model Leave {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member   @relation("LeaveFor", fields: [memberId], references: [id], onDelete: Cascade)
  /// Annual | Sick | Personal | Parental | Unpaid
  type        String
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  note        String   @default("")
  /// pending | approved | declined
  status      String   @default("pending")
  decidedById String?
  decidedBy   Member?  @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("leaves")
}

model Holiday {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  name     String

  @@unique([tenantId, date])
  @@index([tenantId])
  @@map("holidays")
}

/// Every change, attributed and append-only.
model AuditEntry {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  actorId   String?
  actor     Member?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Kept as written, so the entry still reads right after a rename or exit.
  actorName String
  /// expense | task | access | team | client
  kind      String
  /// e.g. `moved “Homepage copy”`
  text      String
  /// What it was about, as shown: a client's name, "Team", "Payroll", …
  target    String
  /// The client it concerns, which is what decides who may read the entry.
  clientId  String?
  /// team | payroll | access | tasks | import | brands — for entries about no client.
  area      String?
  fromValue String   @default("")
  toValue   String   @default("")

  @@index([tenantId, at])
  @@map("audit_log")
}
