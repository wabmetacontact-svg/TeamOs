# --- Database (Neon, free: https://neon.tech) -------------------------------
# Create a project, then copy BOTH connection strings from the dashboard.

# Pooled connection — the app uses this. The host contains "-pooler".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection — migrations use this. Same string WITHOUT "-pooler".
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Login cookie -----------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value in production, and never commit it.
AUTH_SECRET=""
