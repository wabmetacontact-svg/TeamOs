# --- Database (Neon, free: https://neon.tech) -------------------------------
# Create a project, then copy BOTH connection strings from the dashboard.

# Pooled connection — the app uses this. The host contains "-pooler".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection — migrations use this. Same string WITHOUT "-pooler".
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Login cookie -----------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value in production, and never commit it.
AUTH_SECRET=""

# --- Receiving WabMeta's push (optional) ------------------------------------
# Leave both blank and /api/sync/wabmeta answers 503: nothing can be written
# from outside until they are set on purpose.

# Shared with the WabMeta backend, which signs every request with it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WABMETA_SYNC_SECRET=""

# The one workspace WabMeta pushes into. An id, not a slug — the app role
# cannot look a workspace up by slug. Find it with:
#   npx tsx scripts/tenants.ts
WABMETA_TENANT_ID=""
